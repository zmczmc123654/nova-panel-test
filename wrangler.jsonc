{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova-panel-test",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "8a41c762-b324-4fa5-9d8c-0790bf3ffbd6","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "b536a4661c1a4721b63e9c230b1da3c8" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
